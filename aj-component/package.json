{
    "name": "@ajaxjs/ui",
    "version": "1.6.9",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "keywords": [
        "ajaxjs"
    ],
    "author": "Frank Cheung <frank@ajaxjs.com>",
    "license": "Apache License 2.0",
    "description": "Widgets based on iView.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/lightweight-component/js/tree/main/aj-common-ui"
    },
    "bugs": {
        "url": "https://github.com/lightweight-component/js/issues"
    },
    "main": "./dist/ajaxjs-ui.cjs.js",
    "module": "./dist/ajaxjs-ui.es.js",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/ajaxjs-ui.es.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/ajaxjs-ui.cjs.js"
            }
        },
        "./dist/ui.css": "./dist/ui.css",
        "./style.css": "./dist/ui.css"
    },
    "types": "./dist/types/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:lib": "vite build --config vite.lib.config.js",
        "build:demo": "vite build --config vite.app.config.js",
        "preview": "vite preview"
    },
    "dependencies": {
        "codemirror": "^6.0.2",
        "view-ui-plus": "^1.3.20",
        "vue": "^3.5.18",
        "vue-codemirror": "^6.1.1",
        "vue-router": "^4.5.1",
        "vuedraggable": "^4.1.0",
        "@ajaxjs/util": "^1.2.3"
    },
    "devDependencies": {
        "@types/node": "^20.19.15",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.7.0",
        "less": "^4.4.1",
        "typescript": "~5.8.3",
        "vite": "^7.1.2",
        "vite-plugin-dts": "^4.5.4",
        "vue-tsc": "^3.0.5"
    }
}