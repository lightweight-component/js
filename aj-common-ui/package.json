{
    "name": "@ajaxjs/ui",
    "version": "1.4.0",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "keywords": [
        "ajaxjs"
    ],
    "author": "Frank Cheung <frank@ajaxjs.com>",
    "license": "Apache License 2.0",
    "description": "Widgets based on iView.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/lightweight-component/js/tree/main/ui"
    },
    "bugs": {
        "url": "https://github.com/lightweight-component/js/issues"
    },
    "main": "./dist/ajaxjs-ui.cjs.js",
    "module": "./dist/ajaxjs-ui.es.js",
    "exports": {
        ".": {
            "import": "./dist/ajaxjs-ui.es.js",
            "require": "./dist/ajaxjs-ui.cjs.js"
        }
    },
    "types": "./dist/types/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:lib": "vite build --config vite.lib.config.js",
        "build:demo": "vite build --config vite.app.config.js",
        "preview": "vite preview"
    },
    "dependencies": {
        "@ajaxjs/util": "^1.2.1",
        "vue": "^3.5.18"
    },
    "devDependencies": {
        "@types/node": "^20.19.15",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.7.0",
        "less": "^4.4.1",
        "typescript": "~5.8.3",
        "vite": "^7.1.2",
        "vite-plugin-dts": "^4.5.4",
        "vue-tsc": "^3.0.5"
    }
}
